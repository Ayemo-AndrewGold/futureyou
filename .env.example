# ---------------------------------------------------------------------------
# FutureYou Frontend — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# In production (Vercel / Render Static Sites / any host), set these values
# in your host's environment variable dashboard instead.
#
# NEXT_PUBLIC_ prefix = exposed to the browser bundle.
# Variables WITHOUT that prefix are server-only (SSR / Route Handlers).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# The base URL of the Django backend. No trailing slash.
#
# Local development:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Production (Render):
#   NEXT_PUBLIC_API_URL=https://futureyou-backend-bu8o.onrender.com
#
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
